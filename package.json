{
  "name": "azure-mcp",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "MCP server for Microsoft Azure and Entra ID: Microsoft's Azure MCP Server one-to-one, dedicated tools, the Azure CLI one-to-one, multi-tenant service principal profiles, interactive views, and a remote Entra-protected lane.",
  "bin": {
    "azure-mcp": "dist/index.js",
    "azure-mcp-remote": "dist/remote.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run lint && npm run upstream:check && npm test && npm run manifest:check",
    "start": "node dist/index.js",
    "start:remote": "node dist/remote.js",
    "test": "npm run build && node scripts/build-plugin.mjs --check && node --test test/*.test.mjs",
    "manifest": "node scripts/sync-manifest.mjs",
    "manifest:check": "node scripts/sync-manifest.mjs --check",
    "apps:runtime": "node scripts/generate-app-runtime.mjs",
    "mcpb:validate": "npx --yes @anthropic-ai/mcpb@^2 validate manifest.json",
    "mcpb:pack": "npm run build && npm run manifest && npm run mcpb:validate && node scripts/pack-mcpb.mjs azure.mcpb assets",
    "deploy:plan": "bash scripts/deploy-azure.sh --dry-run",
    "plugin:build": "npm run build && node scripts/build-plugin.mjs",
    "plugin:check": "node scripts/build-plugin.mjs --check",
    "lint": "eslint .",
    "upstream:sync": "node scripts/sync-upstream.mjs",
    "upstream:check": "node scripts/sync-upstream.mjs --check"
  },
  "dependencies": {
    "@azure/mcp": "4.0.0-beta.9",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "jose": "^6.2.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "engines": {
    "node": ">=20"
  },
  "author": {
    "name": "Patrick King",
    "email": "patrickk@divergeit.com",
    "url": "https://www.divergeit.com"
  }
}
